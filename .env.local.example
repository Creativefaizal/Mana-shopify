# ---------------------------------------------------------------------------
# Mana :: environment variables
# Copy this file to `.env.local` and fill in the values you own.
# Every integration degrades gracefully: with an empty value the app still
# runs (it falls back to the bundled catalogue and logs emails to the server
# console instead of failing the checkout).
# ---------------------------------------------------------------------------

# ---------- Supabase (database + auth) -------------------------------------
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: SERVER ONLY. Never expose it with the NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Mailgun (transactional email) ----------------------------------
# Mailgun dashboard -> Sending -> Domains -> API keys
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# e.g. Mana Store <hello@mg.yourdomain.com>  (must be on the Mailgun domain)
MAILGUN_FROM=
# Use https://api.eu.mailgun.net for EU-hosted domains (default: US endpoint)
MAILGUN_API_BASE=https://api.mailgun.net
# Where the store owner receives notifications (new order, new subscriber)
STORE_NOTIFICATION_EMAIL=

# ---------- Storefront -----------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Mana

# ---------- Bank transfer (shown at checkout and in the confirmation email) -
# These are public on purpose: every bank-transfer customer needs to see them.
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
